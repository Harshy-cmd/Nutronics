PORT=4000
JWT_SECRET=local-development-secret-change-me
# Supabase server-side Postgres connection string (keep private; never expose with VITE_).
SUPABASE_DATABASE_URL=
CLIENT_ORIGIN=http://localhost:5173
# Client API base URL. Set this to the deployed backend URL before building the client.
VITE_API_URL=http://localhost:4000/api
