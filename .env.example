PORT=4000
JWT_SECRET=local-development-secret-change-me
# Supabase server-side Postgres connection string (keep private; never expose with VITE_).
SUPABASE_DATABASE_URL=
SUPABASE_URL=https://nbcljkbdzptsuuzqbjgk.supabase.co
# Keep this server-only secret; never add a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_ORIGIN=http://localhost:5173
# Client API base URL. Set this to the deployed backend URL before building the client.
VITE_API_URL=http://localhost:4000/api
VITE_GOOGLE_CLIENT_ID=
# Firebase Auth web config (Firebase API keys are public identifiers, not server secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_GOOGLE_CLIENT_ID=
# Firebase project ID used by the API to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=
# Legacy SMTP settings are only used by the old six-digit staff-code flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Google OAuth Client ID must match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
