{
  "name": "nutronics-smart-health-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Nutronics - Smart Health Companion (UN SDG 3). Personalized Wellness Powered by AI and Medical Expertise.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"teal,blue\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server",
    "db:setup": "npm run db:setup --workspace=server",
    "db:migrate:supabase": "npm run db:migrate:supabase --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:import:ifct": "npm run db:import:ifct --workspace=server",
    "db:import:usda": "npm run db:import:usda --workspace=server",
    "db:import:openfda": "npm run db:import:openfda --workspace=server",
    "db:import:all": "npm run db:import:all --workspace=server",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "test": "npm test --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
